# ==========================================
# FinanceFlow Environment Configuration
# ==========================================

# 1. Supabase PostgreSQL Connection String (Transaction Pooler - Recommended for Vercel Serverless)
# Found in Supabase Project Settings -> Database -> Connection string -> URI (Mode: Transaction, Port 6543)
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Supabase Direct Connection String (Required by Prisma for migrations and db push)
# Found in Supabase Project Settings -> Database -> Connection string -> URI (Mode: Session, Port 5432)
DIRECT_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# 3. Next.js JWT Authentication Secret (32+ character random string)
JWT_SECRET="financeflow-super-secure-production-jwt-secret-key-replace-with-random-uuid"

# 4. Optional: Node Environment
NODE_ENV="production"

# ==========================================
# FinanceFlow Environment Configuration
# ==========================================

# 1. Supabase PostgreSQL Connection String (Transaction Pooler - Recommended for Vercel Serverless)
# Found in Supabase Project Settings -> Database -> Connection string -> URI (Mode: Transaction, Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Next.js JWT Authentication Secret (32+ character random string)
JWT_SECRET="financeflow-super-secure-production-jwt-secret-key-replace-with-random-uuid"

# 3. Optional: Node Environment
NODE_ENV="production"
